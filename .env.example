# NyaySetu Backend Configuration
# Copy this to .env and fill in values

# Ollama settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2          # Options: llama3.2, mistral, phi3, gemma2

# ChromaDB path (default: ./db/chroma)
CHROMA_DB_PATH=./db/chroma

# Scraper settings
SCRAPE_HOUR=2                  # Hour to run daily scrape (IST, 24hr)
CRAWL_DELAY_SECONDS=1.5        # Delay between requests (be respectful)
MAX_CHUNKS_PER_SOURCE=50       # Max chunks per source per run

# API settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
